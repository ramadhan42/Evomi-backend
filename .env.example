APP_NAME=Evomi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Akun admin dashboard (dibuat saat php artisan db:seed, non-production)
EVOMI_ADMIN_NAME="Evomi Admin"
EVOMI_ADMIN_EMAIL=admin@evomi.com
EVOMI_ADMIN_PASSWORD=password123

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=belajar_be_website_v2
DB_USERNAME=root
DB_PASSWORD=

# Shared hosting (Hostinger): file drivers avoid extra MySQL round-trips.
# Local/dev may keep database drivers if preferred.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync = no queue worker needed on shared hosting
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Production / Hostinger (api.evomi.shop) — copy these when deploying:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.evomi.shop
# FRONTEND_URL=https://evomi.shop
# LOG_LEVEL=error
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# BCRYPT_ROUNDS=10
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
